#!/bin/bash

set -e

# Usage help
if [ -z "$1" ]; then
    echo "Usage: $0 <login> <item-name> [custom-field-name]"
    exit 1
fi

login="$1"
secret_name="$2"
custom_field_name="$3" # Optional

# Check Bitwarden status
bw_status=$(bw status 2>/dev/null)

state=$(echo "$bw_status" | jq -r '.status')
echo "bw_status: $bw_status" >/tmp/bw_status.log
echo "state=$state" >/tmp/bw-status.log

case "$state" in
"unauthenticated")
    bw login $login
    export BW_SESSION=$(bw unlock --raw)
    ;;
"locked")
    export BW_SESSION=$(bw unlock --raw)
    ;;
"unlocked")
    export BW_SESSION=$(bw unlock --raw)
    ;;
*)
    echo "unknown Bitwarden state: $STATE"
    exit 1
    ;;
esac

item_json=$(bw list items --search "$secret_name")

if [ -z "$item_json" ]; then
    echo "item '$secret_name' not found."
    exit 1
fi

# Try password field first
token=$(echo "$item_json" | jq -r '.[].login.password // empty')

# If no password and a custom field is specified, try that
if [ -z "$token" ] && [ -n "$custom_field_name" ]; then
    echo "trying custom field: '$custom_field_name'..."
    token=$(echo "$item_json" | jq -r --arg field "$custom_field_name" '.fields[]? | select(.name==$field).value')
fi

# Final check
if [ -z "$token" ]; then
    echo "secret not found in item '$secret_name'."
    exit 1
fi

echo "$token"
