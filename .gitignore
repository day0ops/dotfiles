#### Project specific ####
Brewfile.lock.json
automatic_backups
.nvim.lua

# minimal.lua, repro.lua
nvim_issue
.repro

# Work related, e.g. zsh-completion
/work

# Applications storing files ending up in stow/
stow/shared/.config/zed/prompts
stow/Darwin/Library/Application Support/lazygit/state.yml

# Claude Code's runtime state (OAuth/account/session data, machine ID) - not
# meant to be checked in
stow/shared/.claude.json

# Runtime symlink created by stow/shared/.claude-web/web-setup.sh on the web sandbox
/.claude

# Commit signature verification trust file (personal emails + SSH public key) -
# not meant to be checked in, see ~/.gitconfig_signing
stow/shared/.config/git/allowed_signers
